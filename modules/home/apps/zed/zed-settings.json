{
  "language_models": {
    "opencode": {
      "show_free_models": true,
      "show_zen_models": false
    }
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "show_edit_predictions": true,
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "copilot"
  },
  "active_pane_modifiers": {},
  "tabs": {
    "file_icons": true
  },
  "title_bar": {
    "show_menus": false
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "agent": {
    "default_profile": "ask",
    "dock": "right",
    "default_model": {
      "effort": "xhigh",
      "provider": "opencode",
      "model": "go/deepseek-v4-pro",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "window_decorations": "server",
  "minimap": {
    "thumb": "hover",
    "show": "auto"
  },
  "relative_line_numbers": "enabled",
  "buffer_line_height": "standard",
  "icon_theme": "Material Icon Theme",
  "buffer_font_family": ".ZedMono",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "dark": "GitHub Dark",
    "light": "GitHub Light",
    "mode": "system"
  },
  "lsp": {
    "jdtls": {
      "binary": {
        "path": "jdtls"
      }
    },
    "kotlin-lsp": {
      "binary": {
        "path": "kotlin-language-server"
      }
    }
  },
  "ui_font_family": "DejaVu Sans",
  "context_servers": {
    "code-review-graph": {
      "command": "uvx",
      "args": ["code-review-graph", "serve"]
    }
  }
}
